{
    "name": "@peppermint-digital/tasks",
    "version": "0.14.0",
    "description": "Die JS-Seite des Aufgabenpakets — Bauteile, die mehr als ein Produkt braucht.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./inertia": {
            "types": "./dist/inertia/index.d.ts",
            "import": "./dist/inertia/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "prepare": "npm run build"
    },
    "peerDependencies": {
        "@inertiajs/react": "^2 || ^3",
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    },
    "peerDependenciesMeta": {
        "@inertiajs/react": {
            "optional": true
        }
    },
    "dependencies": {
        "@radix-ui/react-slot": "^1.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.2.0"
    },
    "devDependencies": {
        "@inertiajs/react": "^3.7.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    }
}
